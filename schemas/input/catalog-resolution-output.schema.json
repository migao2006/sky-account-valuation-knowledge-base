{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "input/catalog-resolution-output.schema.json",
  "type": "object", "additionalProperties": false, "required": ["schema_version", "resolutions"],
  "properties": {"schema_version": {"const": "1.0"}, "resolutions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["claim_ids", "query_entity_id", "truth_level", "claimed_state", "ownership_state", "resolution_status", "resolved_item_id", "proposed_canonical_item_ids", "candidate_item_ids", "model_feature", "review_status", "reasons"], "properties": {"claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^claim_[a-z0-9_]+$"}, "uniqueItems": true}, "query_entity_id": {"type": "string", "pattern": "^(item_[a-z0-9_]+|reference_identity_[a-f0-9]{32})$"}, "truth_level": {"enum": ["canonical_knowledge", "review_candidate", "source_snapshot_observation", "unknown"]}, "claimed_state": {"enum": ["owned", "confirmed_missing", "unknown", "conflict"]}, "ownership_state": {"enum": ["owned", "confirmed_missing", "unknown"]}, "resolution_status": {"enum": ["canonical_resolved", "review_only", "ambiguous", "unknown_reference", "conflict"]}, "resolved_item_id": {"type": ["string", "null"], "pattern": "^item_[a-z0-9_]+$"}, "proposed_canonical_item_ids": {"type": "array", "items": {"type": "string", "pattern": "^item_[a-z0-9_]+$"}, "uniqueItems": true}, "candidate_item_ids": {"type": "array", "items": {"type": "string", "pattern": "^item_[a-z0-9_]+$"}, "uniqueItems": true}, "model_feature": {"type": "boolean"}, "review_status": {"enum": ["approved", "needs_review", "quarantined", "unknown"]}, "reasons": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}}}}
}
