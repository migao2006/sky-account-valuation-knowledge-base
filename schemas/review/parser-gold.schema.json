{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review/parser-gold.schema.json",
  "description": "P3.8 public parser gold. Raw claims, input hashes and split labels are forbidden; the opaque commitment is resolved only in a signed external replay binding.",
  "type": "object", "additionalProperties": false,
  "required": ["gold_id", "keyed_commitment", "expected_canonical_item_ids", "expected_polarity", "strata"],
  "properties": {
    "gold_id": {"type": "string", "pattern": "^parser_gold_[0-9]{4,}$"},
    "keyed_commitment": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "expected_canonical_item_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^item_[a-z0-9_]+$"}},
    "expected_polarity": {"enum": ["owned", "confirmed_missing", "unknown"]},
    "strata": {"type": "object", "additionalProperties": false, "required": ["account_type", "era", "season", "collaboration", "set_context"], "properties": {"account_type": {"type": "string", "minLength": 1}, "era": {"type": "string", "minLength": 1}, "season": {"type": "string", "minLength": 1}, "collaboration": {"type": "string", "minLength": 1}, "set_context": {"type": "string", "minLength": 1}}}
  }
}
