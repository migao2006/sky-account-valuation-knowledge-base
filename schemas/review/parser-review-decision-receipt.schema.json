{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "review/parser-review-decision-receipt.schema.json",
  "description": "Controlled conversion of an opaque P3.5 assignment to a verifier-compatible external decision row. JSONL must be OpenSSH-signed; it is never formal gold.", "type": "object", "additionalProperties": false,
  "required": ["decision_id", "queue_id", "input_sha256", "reviewer", "expected_canonical_item_ids", "expected_polarity", "decision_commitment_sha256"],
  "properties": {"decision_id": {"type": "string", "pattern": "^receipt_[a-f0-9]{20}$"}, "queue_id": {"type": "string", "pattern": "^parser_review_[a-f0-9]{20}$"}, "reviewer": {"enum": ["annotator_a", "annotator_b"]}, "input_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}, "expected_canonical_item_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^item_[a-z0-9_]+$"}}, "expected_polarity": {"enum": ["owned", "confirmed_missing", "unknown"]}, "decision_commitment_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}}
}
