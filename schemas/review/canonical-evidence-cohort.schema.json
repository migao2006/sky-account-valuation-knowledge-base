{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review/canonical-evidence-cohort.schema.json",
  "description": "Bounded registry for replayable canonical field-evidence cohorts. Verifier IDs are interpreted only by the offline allowlist.",
  "type": "object",
  "additionalProperties": false,
  "required": ["cohort_id", "evidence_path", "verifier_id", "snapshot_paths", "source_ids", "target_item_ids", "target_set_ids", "release_required", "review_status"],
  "properties": {
    "cohort_id": {"type": "string", "pattern": "^canonical_cohort_[a-z0-9_]+$"},
    "evidence_path": {"type": "string", "pattern": "^data/review/(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+\\.jsonl$"},
    "verifier_id": {"enum": ["nintendo_starter_pack", "aurora_faq968", "journey_pack", "moomin_pack", "kizuna_ai_bundle", "skyfest_faq1330_core_five", "tournament_of_triumph_faq1330_core_four", "days_of_color_faq1323_core_three", "days_of_sunlight_faq1343_core_three"]},
    "snapshot_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^data/source/(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+\\.json$"}},
    "source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^source_[a-z0-9_]+$"}},
    "target_item_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^item_[a-z0-9_]+$"}},
    "target_set_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^set_[a-z0-9_]+$"}},
    "release_required": {"type": "boolean"},
    "review_status": {"enum": ["approved", "planned"]}
  },
  "allOf": [
    {"if": {"properties": {"review_status": {"const": "approved"}}}, "then": {"properties": {"snapshot_paths": {"minItems": 1}, "source_ids": {"minItems": 1}, "target_item_ids": {"minItems": 1}}}},
    {"if": {"properties": {"release_required": {"const": true}}}, "then": {"properties": {"review_status": {"const": "approved"}}}}
  ]
}
