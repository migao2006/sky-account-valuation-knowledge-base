{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"review/market-keyed-replay-binding.schema.json","description":"External private custodian binding for a 200-row keyed market finalization. Never publish it.","type":"object","additionalProperties":false,"required":["schema_version","contract_type","cohort_id","custodian_contract_sha256","commitment_merkle_root","split_commitment","authority_id","fingerprint","binding_rows","finalization_sha256","public_gold_sha256"],"properties":{"schema_version":{"const":"1.0-p4.2"},"contract_type":{"const":"market_review_keyed_replay_binding"},"cohort_id":{"type":"string","pattern":"^market_keyed_[a-z0-9_]{8,64}$"},"custodian_contract_sha256":{"type":"string","pattern":"^[A-F0-9]{64}$"},"commitment_merkle_root":{"type":"string","pattern":"^[A-F0-9]{64}$"},"split_commitment":{"type":"string","pattern":"^[A-F0-9]{64}$"},"authority_id":{"type":"string","pattern":"^market_custodian_authority_[a-z0-9_]{3,64}$"},"fingerprint":{"type":"string","minLength":1},"binding_rows":{"type":"array","minItems":200,"maxItems":200,"items":{"type":"object","additionalProperties":false,"required":["cohort_assignment_suffix","review_id","listing_id","listing_text_sha256","keyed_commitment","bucket","split"],"properties":{"cohort_assignment_suffix":{"type":"string","pattern":"^[a-f0-9]{32}$"},"review_id":{"type":"string","pattern":"^market_claim_review_[0-9]{4}$"},"listing_id":{"type":"string","pattern":"^listing_[0-9]{4}$"},"listing_text_sha256":{"type":"string","pattern":"^[A-F0-9]{64}$"},"keyed_commitment":{"type":"string","pattern":"^[A-F0-9]{64}$"},"bucket":{"type":"integer","minimum":0,"maximum":19},"split":{"enum":["development","heldout"]}}}},"finalization_sha256":{"type":"string","pattern":"^[A-F0-9]{64}$"},"public_gold_sha256":{"type":"string","pattern":"^[A-F0-9]{64}$"}}}
