{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review/item-promotion-evidence.schema.json",
  "description": "Pinned, reviewed item facts eligible for an offline P2.5 promotion dry run. This record never writes canonical knowledge.",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "candidate_item_id", "proposed_canonical_item_id", "field_path", "claim_value", "claim_hash", "source_id", "source_lineage_id", "source_tier", "source_snapshot_path", "source_snapshot_bytes", "source_snapshot_hash", "claim_locator", "claim_locator_hash", "evidence_role", "review_status", "reviewed_at"],
  "properties": {
    "evidence_id": {"type": "string", "pattern": "^item_evidence_[a-z0-9_]+$"},
    "candidate_item_id": {"type": "string", "pattern": "^item_[a-z0-9_]+$"},
    "proposed_canonical_item_id": {"type": "string", "pattern": "^item_[a-z0-9_]+$"},
    "field_path": {"enum": ["canonical_identity", "canonical_name_en", "canonical_name_zh_tw", "item_category", "season_id", "source_type", "alias", "template_suffix_identity"]},
    "claim_value": {"type": ["string", "null"]},
    "claim_hash": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "source_id": {"type": "string", "pattern": "^source_[a-z0-9_]+$"},
    "source_lineage_id": {"type": "string", "pattern": "^lineage_[a-z0-9_]+$"},
    "source_tier": {"enum": ["official_item_specific", "official_general", "maintained_community", "secondary_reference"]},
    "source_snapshot_path": {"type": "string", "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
    "source_snapshot_bytes": {"type": "integer", "minimum": 1},
    "source_snapshot_hash": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "claim_locator": {"type": "string", "pattern": "^/"},
    "claim_locator_hash": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "evidence_role": {"enum": ["independent_identity", "independent_field", "alias_review", "template_suffix_review"]},
    "review_status": {"const": "approved"},
    "reviewed_at": {"type": "string", "format": "date"},
    "notes": {"type": "string"}
  }
}
