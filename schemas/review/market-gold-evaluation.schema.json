{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review/market-gold-evaluation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "publication_ready", "gold_row_count", "minimums", "partition_method", "bucket_coverage", "metrics", "heldout_minimum_annotator_field_accuracy", "heldout_verified_sale_false_positive_count", "independent_blinded_decisions_proven", "audit_errors", "independence_errors", "linkage_errors", "blocking_reasons"],
  "properties": {
    "schema_version": {"const": "market-gold-evaluation-v1"},
    "status": {"enum": ["evaluated", "not_ready"]},
    "publication_ready": {"type": "boolean"},
    "gold_row_count": {"type": "integer", "minimum": 0},
    "minimums": {"type": "object"},
    "partition_method": {"const": "opaque_bucket_review_id_alternating_v1"},
    "bucket_coverage": {"type": "object"},
    "metrics": {"type": "object"},
    "heldout_minimum_annotator_field_accuracy": {"type": "object", "required": ["offer_kind", "entity_kind", "price_type", "currency", "server"]},
    "heldout_verified_sale_false_positive_count": {"type": "integer", "minimum": 0},
    "independent_blinded_decisions_proven": {"type": "boolean"},
    "audit_errors": {"type": "array", "items": {"type": "string"}},
    "independence_errors": {"type": "array", "items": {"type": "string"}},
    "linkage_errors": {"type": "array", "items": {"type": "string"}},
    "blocking_reasons": {"type": "array", "items": {"type": "string"}}
  }
}
