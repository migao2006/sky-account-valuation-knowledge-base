{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"review/parser-review-keyed-decision.schema.json",
  "description":"External-only P3.6 reviewer receipt. It binds an opaque assignment only; input hashes, keyed commitments, queue IDs and split labels are forbidden.",
  "type":"object", "additionalProperties":false,
  "required":["decision_id","assignment_id","reviewer","expected_canonical_item_ids","expected_polarity","decision_commitment_sha256"],
  "properties":{
    "decision_id":{"type":"string","pattern":"^keyed_receipt_[a-z0-9_]{8,64}$"}, "assignment_id":{"type":"string","pattern":"^assignment_annotator_[ab]_[a-f0-9]{32}$"}, "reviewer":{"enum":["annotator_a","annotator_b"]},
    "expected_canonical_item_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^item_[a-z0-9_]+$"}}, "expected_polarity":{"enum":["owned","confirmed_missing","unknown"]}, "decision_commitment_sha256":{"type":"string","pattern":"^[A-F0-9]{64}$"}
  }
}
