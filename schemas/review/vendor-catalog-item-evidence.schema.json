{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review/vendor-catalog-item-evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "candidate_item_id", "field_path", "claim_value", "claim_value_hash", "source_id", "snapshot_id", "snapshot_sha256", "locator", "vendor_item_id", "vendor_item_type", "evidence_role", "review_status", "canonical_promotion"],
  "properties": {
    "evidence_id": {"type": "string", "pattern": "^evidence_vendor_[a-f0-9]{24}$"},
    "candidate_item_id": {"type": "string", "pattern": "^item_[a-z0-9_]+$"},
    "field_path": {"const": "candidate_name_en"},
    "claim_value": {"type": "string", "minLength": 1},
    "claim_value_hash": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "source_id": {"const": "source_skygame_data_1_3_4"},
    "snapshot_id": {"const": "vendor_skygame_data_1_3_4"},
    "snapshot_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "locator": {"type": "string", "minLength": 1},
    "vendor_item_id": {"type": "integer", "minimum": 0},
    "vendor_item_type": {"type": "string", "minLength": 1},
    "evidence_role": {"const": "secondary_exact_normalized_name"},
    "review_status": {"const": "needs_review"},
    "canonical_promotion": {"const": "prohibited_without_independent_review"}
  }
}
