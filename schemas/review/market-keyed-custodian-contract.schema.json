{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"review/market-keyed-custodian-contract.schema.json","description":"External-only signed P4.1 contract; contains no listing ID/hash, review ID, secret, per-row assignment, or per-row split.","type":"object","additionalProperties":false,"required":["schema_version","contract_type","cohort_id","keyed_protocol","queue_size","assignment_count","packet_counts","commitment_merkle_root","split_commitment","packet_sha256","assignment_ledger_sha256","custodian_id","authority_id","fingerprint","signature_file","contract_sha256"],"properties":{"schema_version":{"const":"1.0-p4.1"},"contract_type":{"const":"market_review_keyed_custodian_contract"},"cohort_id":{"type":"string","pattern":"^market_keyed_[a-z0-9_]{8,64}$"},"keyed_protocol":{"const":"sky-market-review-keyed-custodian-v1"},"queue_size":{"const":200},"assignment_count":{"const":400},"packet_counts":{"const":{"annotator_a":200,"annotator_b":200}},"commitment_merkle_root":{"type":"string","pattern":"^[A-F0-9]{64}$"},"split_commitment":{"type":"string","pattern":"^[A-F0-9]{64}$"},"packet_sha256":{"type":"object","additionalProperties":false,"required":["annotator_a","annotator_b"],"properties":{"annotator_a":{"type":"string","pattern":"^[A-F0-9]{64}$"},"annotator_b":{"type":"string","pattern":"^[A-F0-9]{64}$"}}},"assignment_ledger_sha256":{"type":"string","pattern":"^[A-F0-9]{64}$"},"custodian_id":{"type":"string","pattern":"^market_custodian_[a-z0-9_]{3,64}$"},"authority_id":{"type":"string","pattern":"^market_custodian_authority_[a-z0-9_]{3,64}$"},"fingerprint":{"type":"string","minLength":1},"signature_file":{"type":"string","pattern":"^[a-zA-Z0-9._-]+\\.sig$"},"contract_sha256":{"type":"string","pattern":"^[A-F0-9]{64}$"}}}
