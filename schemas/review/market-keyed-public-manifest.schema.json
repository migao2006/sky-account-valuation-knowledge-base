{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"review/market-keyed-public-manifest.schema.json","description":"Public aggregate-only P4.1 market keyed-custodian manifest.","type":"object","additionalProperties":false,"required":["schema_version","status","cohort_id","keyed_protocol","queue_size","assignment_count","packet_counts","commitment_merkle_root","split_commitment","packet_sha256","custodian_id","custodian_authority_id","custodian_fingerprint","custodian_contract_sha256","manifest_sha256"],"properties":{"schema_version":{"const":"1.0-p4.1"},"status":{"const":"keyed_frozen_pending_external_decisions"},"cohort_id":{"type":"string","pattern":"^market_keyed_[a-z0-9_]{8,64}$"},"keyed_protocol":{"const":"sky-market-review-keyed-custodian-v1"},"queue_size":{"const":200},"assignment_count":{"const":400},"packet_counts":{"const":{"annotator_a":200,"annotator_b":200}},"commitment_merkle_root":{"type":"string","pattern":"^[A-F0-9]{64}$"},"split_commitment":{"type":"string","pattern":"^[A-F0-9]{64}$"},"packet_sha256":{"type":"object","additionalProperties":false,"required":["annotator_a","annotator_b"],"properties":{"annotator_a":{"type":"string","pattern":"^[A-F0-9]{64}$"},"annotator_b":{"type":"string","pattern":"^[A-F0-9]{64}$"}}},"custodian_id":{"type":"string","pattern":"^market_custodian_[a-z0-9_]{3,64}$"},"custodian_authority_id":{"type":"string","pattern":"^market_custodian_authority_[a-z0-9_]{3,64}$"},"custodian_fingerprint":{"type":"string","minLength":1},"custodian_contract_sha256":{"type":"string","pattern":"^[A-F0-9]{64}$"},"manifest_sha256":{"type":"string","pattern":"^[A-F0-9]{64}$"}}}
