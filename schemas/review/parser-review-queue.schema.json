{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review/parser-review-queue.schema.json",
  "description": "Anonymous frozen parser-review queue. It must not contain raw text, account/listing IDs, URLs, or reviewer labels.",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "status", "queue_size", "reason"],
      "properties": {"schema_version": {"const": "1.0-p3.4"}, "status": {"const": "not_ready"}, "queue_size": {"const": 0}, "reason": {"type": "string", "minLength": 1}}
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "status", "queue_size", "split_counts", "required_strata", "source_sha256", "queue", "strata_distinct_value_counts", "restricted_packet_sha256", "development_freeze_sha256", "heldout_blindness", "manifest_sha256"],
  "properties": {"schema_version": {"const": "1.0-p3.4"}, "status": {"const": "frozen_pending_external_decisions"}, "queue_size": {"const": 200}, "split_counts": {"const": {"development": 100, "heldout": 100}}, "required_strata": {"const": ["account_type", "era", "season", "collaboration", "set_context"]}, "source_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}, "queue": {"type": "array", "minItems": 200, "maxItems": 200, "items": {"type": "object", "additionalProperties": false, "required": ["queue_id", "input_sha256", "strata", "split"], "properties": {"queue_id": {"type": "string", "pattern": "^parser_review_[a-f0-9]{20}$"}, "input_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}, "split": {"enum": ["development", "heldout"]}, "strata": {"type": "object", "additionalProperties": false, "required": ["account_type", "era", "season", "collaboration", "set_context"], "properties": {"account_type": {"type": "string", "pattern": "^bucket_[0-9]{1,2}$"}, "era": {"type": "string", "pattern": "^bucket_[0-9]{1,2}$"}, "season": {"type": "string", "pattern": "^bucket_[0-9]{1,2}$"}, "collaboration": {"type": "string", "pattern": "^bucket_[0-9]{1,2}$"}, "set_context": {"type": "string", "pattern": "^bucket_[0-9]{1,2}$"}}}}}}, "strata_distinct_value_counts": {"type": "object"}, "restricted_packet_sha256": {"type": "object", "required": ["development", "heldout"], "additionalProperties": false, "properties": {"development": {"type": "string", "pattern": "^[A-F0-9]{64}$"}, "heldout": {"type": "string", "pattern": "^[A-F0-9]{64}$"}}}, "development_freeze_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}, "heldout_blindness": {"type": "string", "minLength": 1}, "manifest_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}}
}
    ,
    {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "status", "cohort_id", "keyed_protocol", "queue_size", "split_counts", "required_strata", "strata_distinct_value_counts", "commitment_merkle_root", "split_commitment", "packet_sha256", "assignment_ledger_sha256", "custodian_id", "custodian_authority_id", "custodian_fingerprint", "custodian_contract_sha256", "manifest_sha256"],
      "properties": {
        "schema_version": {"const": "1.0-p3.7"}, "status": {"const": "keyed_frozen_pending_external_decisions"},
        "cohort_id": {"type": "string", "pattern": "^parser_keyed_[a-z0-9_]{8,64}$"}, "keyed_protocol": {"const": "sky-parser-review-keyed-hmac-v1"},
        "queue_size": {"const": 200}, "split_counts": {"const": {"development": 100, "heldout": 100}}, "required_strata": {"const": ["account_type", "era", "season", "collaboration", "set_context"]},
        "strata_distinct_value_counts": {"type": "object", "additionalProperties": false, "required": ["account_type", "era", "season", "collaboration", "set_context"], "properties": {"account_type": {"type":"integer", "minimum":2}, "era": {"type":"integer", "minimum":2}, "season": {"type":"integer", "minimum":2}, "collaboration": {"type":"integer", "minimum":2}, "set_context": {"type":"integer", "minimum":2}}},
        "commitment_merkle_root": {"type":"string", "pattern":"^[A-F0-9]{64}$"}, "split_commitment": {"type":"string", "pattern":"^[A-F0-9]{64}$"},
        "packet_sha256": {"type":"object", "additionalProperties":false, "required":["annotator_a", "annotator_b"], "properties":{"annotator_a":{"type":"string", "pattern":"^[A-F0-9]{64}$"}, "annotator_b":{"type":"string", "pattern":"^[A-F0-9]{64}$"}}},
        "assignment_ledger_sha256": {"type":"string", "pattern":"^[A-F0-9]{64}$"}, "custodian_id": {"type":"string", "pattern":"^parser_custodian_[a-z0-9_]{3,64}$"}, "custodian_authority_id": {"type":"string", "pattern":"^parser_custodian_authority_[a-z0-9_]{3,64}$"}, "custodian_fingerprint": {"type":"string", "minLength":1}, "custodian_contract_sha256": {"type":"string", "pattern":"^[A-F0-9]{64}$"}, "manifest_sha256": {"type":"string", "pattern":"^[A-F0-9]{64}$"}
      }
    }
  ]
}
