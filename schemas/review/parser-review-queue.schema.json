{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review/parser-review-queue.schema.json",
  "description": "Anonymous frozen parser-review queue. It must not contain raw text, account/listing IDs, URLs, or reviewer labels.",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "status", "queue_size", "reason"],
      "properties": {"schema_version": {"const": "1.0-p3.4"}, "status": {"const": "not_ready"}, "queue_size": {"const": 0}, "reason": {"type": "string", "minLength": 1}}
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "status", "queue_size", "split_counts", "required_strata", "source_sha256", "queue", "strata_distinct_value_counts", "restricted_packet_sha256", "development_freeze_sha256", "heldout_blindness", "manifest_sha256"],
  "properties": {"schema_version": {"const": "1.0-p3.4"}, "status": {"const": "frozen_pending_external_decisions"}, "queue_size": {"const": 200}, "split_counts": {"const": {"development": 100, "heldout": 100}}, "required_strata": {"const": ["account_type", "era", "season", "collaboration", "set_context"]}, "source_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}, "queue": {"type": "array", "minItems": 200, "maxItems": 200, "items": {"type": "object", "additionalProperties": false, "required": ["queue_id", "input_sha256", "strata", "split"], "properties": {"queue_id": {"type": "string", "pattern": "^parser_review_[a-f0-9]{20}$"}, "input_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}, "split": {"enum": ["development", "heldout"]}, "strata": {"type": "object", "additionalProperties": false, "required": ["account_type", "era", "season", "collaboration", "set_context"], "properties": {"account_type": {"type": "string", "minLength": 1}, "era": {"type": "string", "minLength": 1}, "season": {"type": "string", "minLength": 1}, "collaboration": {"type": "string", "minLength": 1}, "set_context": {"type": "string", "minLength": 1}}}}}}, "strata_distinct_value_counts": {"type": "object"}, "restricted_packet_sha256": {"type": "object", "required": ["development", "heldout"], "additionalProperties": false, "properties": {"development": {"type": "string", "pattern": "^[A-F0-9]{64}$"}, "heldout": {"type": "string", "pattern": "^[A-F0-9]{64}$"}}}, "development_freeze_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}, "heldout_blindness": {"type": "string", "minLength": 1}, "manifest_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}}
}
  ]
}
