{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review/parser-keyed-custodian-authority-bundle.schema.json",
  "description": "External-only SHA-pinned trust root for P3.7 parser keyed custodians.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "authorities", "revoked_fingerprints"],
  "properties": {
    "schema_version": {"const": "sky-parser-keyed-custodian-authority-bundle-v1"},
    "authorities": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["authority_id", "public_key", "fingerprint", "roles"], "properties": {"authority_id": {"type": "string", "pattern": "^parser_custodian_authority_[a-z0-9_]{3,64}$"}, "public_key": {"type": "string", "minLength": 1}, "fingerprint": {"type": "string", "minLength": 1}, "roles": {"type": "array", "uniqueItems": true, "items": {"type": "string"}, "contains": {"const": "keyed_custodian_contract"}}}}},
    "revoked_fingerprints": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
