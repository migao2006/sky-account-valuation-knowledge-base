{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"review/market-keyed-assignment-ledger.schema.json","description":"External-only 400-row opaque market A/B assignment ledger. No listing/review/split linkage is permitted.","type":"object","additionalProperties":false,"required":["assignment_id","reviewer"],"properties":{"assignment_id":{"type":"string","pattern":"^market_assignment_annotator_[ab]_[a-f0-9]{32}$"},"reviewer":{"enum":["annotator_a","annotator_b"]}},"allOf":[{"if":{"properties":{"reviewer":{"const":"annotator_a"}}},"then":{"properties":{"assignment_id":{"pattern":"^market_assignment_annotator_a_[a-f0-9]{32}$"}}}},{"if":{"properties":{"reviewer":{"const":"annotator_b"}}},"then":{"properties":{"assignment_id":{"pattern":"^market_assignment_annotator_b_[a-f0-9]{32}$"}}}}]}
