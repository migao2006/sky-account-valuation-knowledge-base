{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"review/market-keyed-finalization.schema.json","description":"Signed-keyed market finalization receipt; private resolution mapping is external.","type":"object","additionalProperties":false,"required":["schema_version","status","cohort_id","custodian_contract_sha256","annotator_a_ledger_sha256","annotator_b_ledger_sha256","adjudication_ledger_sha256","agreement_count","disagreement_count","formal_gold_written"],"properties":{"schema_version":{"const":"1.0-p4.2"},"status":{"const":"external_keyed_finalization_verified"},"cohort_id":{"type":"string","pattern":"^market_keyed_[a-z0-9_]{8,64}$"},"custodian_contract_sha256":{"type":"string","pattern":"^[A-F0-9]{64}$"},"annotator_a_ledger_sha256":{"type":"string","pattern":"^[A-F0-9]{64}$"},"annotator_b_ledger_sha256":{"type":"string","pattern":"^[A-F0-9]{64}$"},"adjudication_ledger_sha256":{"type":"string","pattern":"^[A-F0-9]{64}$"},"agreement_count":{"type":"integer","minimum":0,"maximum":200},"disagreement_count":{"type":"integer","minimum":0,"maximum":200},"formal_gold_written":{"const":false}}}
