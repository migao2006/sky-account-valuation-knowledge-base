{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"review/parser-review-candidate-ledger.schema.json","description":"Non-gold candidate import. It must never be treated as parser-gold evidence.","type":"object","additionalProperties":false,"required":["schema_version","status","queue_manifest_sha256","candidate_count","conflict_count","candidates","formal_gold_written","ledger_sha256"],"properties":{"schema_version":{"const":"1.0-p3.5"},"status":{"const":"candidate_labels_only"},"queue_manifest_sha256":{"type":"string","pattern":"^[A-F0-9]{64}$"},"candidate_count":{"type":"integer","minimum":0,"maximum":200},"conflict_count":{"type":"integer","minimum":0,"maximum":200},"candidates":{"type":"array","maxItems":200,"items":{"type":"object","additionalProperties":false,"required":["candidate_id","input_sha256","expected_canonical_item_ids","expected_polarity","source"],"properties":{"candidate_id":{"type":"string","pattern":"^candidate_[a-f0-9]{20}$"},"input_sha256":{"type":"string","pattern":"^[A-F0-9]{64}$"},"expected_canonical_item_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^item_[a-z0-9_]+$"}},"expected_polarity":{"enum":["owned","confirmed_missing","unknown"]},"source":{"const":"independent_ab_agreement"}}}},"formal_gold_written":{"const":false},"ledger_sha256":{"type":"string","pattern":"^[A-F0-9]{64}$"}}}
