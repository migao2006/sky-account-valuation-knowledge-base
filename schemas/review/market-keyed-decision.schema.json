{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"review/market-keyed-decision.schema.json","description":"One opaque, signed human decision. Public linkage is withheld until custodial finalization.","type":"object","additionalProperties":false,"required":["decision_id","assignment_id","reviewer","annotator_id","annotated_at","labels","decision_commitment_sha256"],"properties":{"decision_id":{"type":"string","minLength":1},"assignment_id":{"type":"string","pattern":"^market_assignment_annotator_[ab]_[a-f0-9]{32}$"},"reviewer":{"enum":["annotator_a","annotator_b"]},"annotator_id":{"type":"string","pattern":"^human_[a-z0-9_]+$"},"annotated_at":{"type":"string","format":"date"},"labels":{"type":"object"},"decision_commitment_sha256":{"type":"string","pattern":"^[A-F0-9]{64}$"}}}
