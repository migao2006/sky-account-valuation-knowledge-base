{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review/parser-review-keyed-custodian-contract.schema.json",
  "description": "External-only P3.6 contract. It intentionally contains no raw input, HMAC secret, individual input commitment, assignment-to-input map, or individual split.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "contract_type", "cohort_id", "keyed_protocol", "queue_size", "split_counts", "required_strata", "strata_distinct_value_counts", "commitment_merkle_root", "split_commitment", "packet_sha256", "assignment_ledger_sha256", "custodian_id", "public_key", "fingerprint", "signature_file", "contract_sha256"],
  "properties": {
    "schema_version": {"const": "1.0-p3.6"}, "contract_type": {"const": "parser_review_keyed_custodian_contract"}, "cohort_id": {"type": "string", "pattern": "^parser_keyed_[a-z0-9_]{8,64}$"}, "keyed_protocol": {"const": "sky-parser-review-keyed-hmac-v1"},
    "queue_size": {"const": 200}, "split_counts": {"const": {"development":100,"heldout":100}}, "required_strata": {"const":["account_type","era","season","collaboration","set_context"]},
    "strata_distinct_value_counts": {"type":"object","additionalProperties":false,"required":["account_type","era","season","collaboration","set_context"],"properties":{"account_type":{"type":"integer","minimum":2},"era":{"type":"integer","minimum":2},"season":{"type":"integer","minimum":2},"collaboration":{"type":"integer","minimum":2},"set_context":{"type":"integer","minimum":2}}},
    "commitment_merkle_root":{"type":"string","pattern":"^[A-F0-9]{64}$"}, "split_commitment":{"type":"string","pattern":"^[A-F0-9]{64}$"}, "packet_sha256":{"type":"object","additionalProperties":false,"required":["annotator_a","annotator_b"],"properties":{"annotator_a":{"type":"string","pattern":"^[A-F0-9]{64}$"},"annotator_b":{"type":"string","pattern":"^[A-F0-9]{64}$"}}}, "assignment_ledger_sha256":{"type":"string","pattern":"^[A-F0-9]{64}$"},
    "custodian_id":{"type":"string","pattern":"^parser_custodian_[a-z0-9_]{3,64}$"}, "public_key":{"type":"string","minLength":1}, "fingerprint":{"type":"string","minLength":1}, "signature_file":{"type":"string","pattern":"^[a-zA-Z0-9._-]+\\.sig$"}, "contract_sha256":{"type":"string","pattern":"^[A-F0-9]{64}$"}
  }
}
