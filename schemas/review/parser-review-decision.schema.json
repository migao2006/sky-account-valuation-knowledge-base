{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review/parser-review-decision.schema.json",
  "description": "External-only independent parser-review decision. Do not commit it to the release root.",
  "type": "object", "additionalProperties": false,
  "required": ["decision_id", "queue_id", "input_sha256", "reviewer", "expected_canonical_item_ids", "expected_polarity", "decision_commitment_sha256"],
  "properties": {"decision_id": {"type": "string"}, "queue_id": {"type": "string", "pattern": "^parser_review_[a-f0-9]{20}$"}, "input_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}, "reviewer": {"enum": ["annotator_a", "annotator_b"]}, "expected_canonical_item_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^item_[a-z0-9_]+$"}}, "expected_polarity": {"enum": ["owned", "confirmed_missing", "unknown"]}, "decision_commitment_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}}
}
