{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review/parser-review-keyed-replay-binding.schema.json",
  "description": "External-only P3.7 replay binding. It is never published in the release because its rows bind formal gold hashes and private split assignments to opaque keyed commitments.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "contract_type", "cohort_id", "custodian_contract_sha256", "commitment_merkle_root", "split_commitment", "authority_id", "fingerprint", "cohort_keyed_commitments", "binding_rows", "signature_file", "binding_sha256"],
  "properties": {
    "schema_version": {"const": "1.0-p3.7"}, "contract_type": {"const": "parser_review_keyed_replay_binding"},
    "cohort_id": {"type": "string", "pattern": "^parser_keyed_[a-z0-9_]{8,64}$"}, "custodian_contract_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}, "commitment_merkle_root": {"type": "string", "pattern": "^[A-F0-9]{64}$"}, "split_commitment": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "authority_id": {"type": "string", "pattern": "^parser_custodian_authority_[a-z0-9_]{3,64}$"}, "fingerprint": {"type": "string", "minLength": 1},
    "cohort_keyed_commitments": {"type": "array", "minItems": 200, "maxItems": 200, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-F0-9]{64}$"}},
    "binding_rows": {"type": "array", "minItems": 1, "maxItems": 200, "items": {"type": "object", "additionalProperties": false, "required": ["gold_id", "input_sha256", "keyed_commitment", "split"], "properties": {"gold_id": {"type": "string", "pattern": "^parser_gold_[0-9]{4,}$"}, "input_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}, "keyed_commitment": {"type": "string", "pattern": "^[A-F0-9]{64}$"}, "split": {"enum": ["development", "heldout"]}}}},
    "signature_file": {"type": "string", "pattern": "^[a-zA-Z0-9._-]+\\.sig$"}, "binding_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}
  }
}
