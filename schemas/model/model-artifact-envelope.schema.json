{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model/model-artifact-envelope.schema.json",
  "title": "Offline model artifact envelope",
  "type": "object",
  "required": ["schema_version", "status", "model_type", "price_line", "training", "feature_schema", "input_snapshot_paths", "input_snapshot_sha256", "prediction_contract"],
  "properties": {
    "schema_version": {"const": "3.1-p1"},
    "status": {"enum": ["trained", "insufficient_training_data", "dependency_unavailable", "training_failed"]},
    "model_type": {"enum": ["elastic_net", "xgboost"]},
    "price_line": {"enum": ["normal_listing", "urgent_sale"]},
    "training": {"type": "object", "required": ["threshold_met", "baseline_beaten", "outer_cv_mae"], "properties": {"threshold_met": {"type": "boolean"}, "baseline_beaten": {"type": "boolean"}, "outer_cv_mae": {"type": ["number", "null"], "minimum": 0}, "eligible_rows": {"type": "integer", "minimum": 0}, "minimum_rows": {"type": "integer", "minimum": 1}, "group_count": {"type": "integer", "minimum": 0}, "folds": {"type": "integer", "minimum": 0}, "baseline_mae": {"type": ["number", "null"]}}},
    "feature_schema": {"type": "object"},
    "input_snapshot_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[^\\\\]+(?:/[^\\\\]+)*$"}},
    "input_snapshot_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "prediction_contract": {"type": "object"}
  }
}
