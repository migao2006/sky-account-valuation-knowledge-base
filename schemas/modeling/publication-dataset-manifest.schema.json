{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "modeling/publication-dataset-manifest.schema.json",
  "title": "Frozen, replayable candidate publication dataset",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "status", "dataset_path", "dataset_sha256", "dataset_row_count", "input_snapshots", "catalog_provenance", "market_pools", "dataset_rows"],
  "properties": {
    "schema_version": {"const": "1.1-p3.2"}, "status": {"enum": ["not_ready", "ready_for_evaluation"]},
    "dataset_path": {"const": "reports/model-publication-dataset-manifest.json#dataset_rows"},
    "dataset_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}, "dataset_row_count": {"type": "integer", "minimum": 0},
    "input_snapshots": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}}}},
    "catalog_provenance": {"type": "object"},
    "market_pools": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["currency", "server", "price_line", "row_count", "rows_sha256"], "properties": {"currency": {"const": "TWD"}, "server": {"const": "international"}, "price_line": {"enum": ["normal_listing", "urgent_sale"]}, "row_count": {"type": "integer", "minimum": 0}, "rows_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}}}},
    "dataset_rows": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["cleaned_price_id", "history_id", "account_id", "cluster_id", "currency", "server", "price_line", "selected_price_twd", "post_date", "date_verified", "row_sha256"], "allOf": [{"if": {"required": ["training_example_id"]}, "then": {"required": ["training_example_digest", "feature_payload_sha256", "catalog_provenance_sha256", "dedup_cluster_digest"]}}], "properties": {"cleaned_price_id": {"type": "string"}, "history_id": {"type": "string"}, "account_id": {"type": "string"}, "cluster_id": {"type": "string"}, "currency": {"const": "TWD"}, "server": {"const": "international"}, "price_line": {"enum": ["normal_listing", "urgent_sale"]}, "selected_price_twd": {"type": "number", "exclusiveMinimum": 0}, "post_date": {"type": "string", "format": "date"}, "date_verified": {"const": true}, "training_example_id": {"type": "string", "pattern": "^training_example_[a-z0-9_]+$"}, "training_example_digest": {"type": "string", "pattern": "^[A-F0-9]{64}$"}, "feature_payload_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}, "catalog_provenance_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}, "dedup_cluster_digest": {"type": "string", "pattern": "^[A-F0-9]{64}$"}, "row_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}}}}
  }
}
