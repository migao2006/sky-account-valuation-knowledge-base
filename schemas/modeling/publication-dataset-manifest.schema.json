{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "modeling/publication-dataset-manifest.schema.json",
  "title": "Frozen, replayable candidate publication dataset",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "status", "lineage_mode", "feature_payload_contract", "dataset_path", "dataset_sha256", "dataset_row_count", "input_snapshots", "catalog_provenance", "market_pools", "rejected_clean_row_count", "rejection_counts", "blockers", "dataset_rows"],
  "properties": {
    "schema_version": {"const": "1.2-p3.4"}, "status": {"enum": ["not_ready", "ready_for_evaluation"]},
    "lineage_mode": {"const": "production_signed"},
    "feature_payload_contract": {"type": "object", "additionalProperties": false, "required": ["schema_version", "evaluator_feature_source", "evaluation_subgroup_derivation"], "properties": {"schema_version": {"const": "signed-account-feature-payload-v1"}, "evaluator_feature_source": {"const": "feature_payload.feature_groups"}, "evaluation_subgroup_derivation": {"const": "feature_payload.feature_groups.base_account.account_type_or_unknown"}}},
    "dataset_path": {"const": "reports/model-publication-dataset-manifest.json#dataset_rows"},
    "dataset_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}, "dataset_row_count": {"type": "integer", "minimum": 0},
    "input_snapshots": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}}}},
    "catalog_provenance": {"type": "object"},
    "market_pools": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["currency", "server", "price_line", "row_count", "rows_sha256"], "properties": {"currency": {"const": "TWD"}, "server": {"const": "international"}, "price_line": {"enum": ["normal_listing", "urgent_sale", "verified_sale"]}, "row_count": {"type": "integer", "minimum": 0}, "rows_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}}}},
    "rejected_clean_row_count": {"type": "integer", "minimum": 0},
    "rejection_counts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["reason", "count"], "properties": {"reason": {"enum": ["unsigned_clean_row", "incomplete_signed_feature_lineage"]}, "count": {"type": "integer", "minimum": 1}}}},
    "blockers": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["code", "count"], "properties": {"code": {"const": "unsigned_clean_rows_excluded"}, "count": {"type": "integer", "minimum": 1}}}},
    "dataset_rows": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["cleaned_price_id", "history_id", "account_id", "cluster_id", "currency", "server", "price_line", "selected_price_twd", "post_date", "date_verified", "training_example_id", "training_example_digest", "feature_payload", "feature_payload_sha256", "catalog_provenance_sha256", "dedup_cluster_digest", "evaluation_subgroup", "row_sha256"], "properties": {"cleaned_price_id": {"type": "string"}, "history_id": {"type": "string"}, "account_id": {"type": "string"}, "cluster_id": {"type": "string"}, "currency": {"const": "TWD"}, "server": {"const": "international"}, "price_line": {"enum": ["normal_listing", "urgent_sale", "verified_sale"]}, "selected_price_twd": {"type": "number", "exclusiveMinimum": 0}, "post_date": {"type": "string", "format": "date"}, "date_verified": {"const": true}, "training_example_id": {"type": "string", "pattern": "^training_example_[a-z0-9_]+$"}, "training_example_digest": {"type": "string", "pattern": "^[A-F0-9]{64}$"}, "feature_payload": {"type": "object"}, "feature_payload_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}, "catalog_provenance_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}, "dedup_cluster_digest": {"type": "string", "pattern": "^[A-F0-9]{64}$"}, "evaluation_subgroup": {"type": "string", "minLength": 1}, "completed_sale_verified": {"const": true}, "sale_verified": {"const": true}, "completed_sale_date": {"type": "string", "format": "date"}, "completion_evidence_digest": {"type": "string", "pattern": "^[A-F0-9]{64}$"}, "independent_evidence_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^evidence_[a-z0-9_]+$"}}, "observation_row_digest": {"type": "string", "pattern": "^[A-F0-9]{64}$"}, "row_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}}}}
  }
}
