{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "modeling/elastic-net-artifact.schema.json",
  "title": "Offline P1 Elastic Net artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "price_line", "model_type", "random_seed", "input_snapshot_paths", "input_snapshot_sha256", "catalog_provenance", "training", "publication_gate", "feature_schema", "prediction_contract", "rejected_rows", "limitations", "artifact"],
  "properties": {
    "schema_version": {"const": "3.1-p1"},
    "status": {"enum": ["trained", "insufficient_training_data", "dependency_unavailable", "training_failed"]},
    "price_line": {"enum": ["normal_listing", "urgent_sale"]},
    "model_type": {"const": "elastic_net"},
    "random_seed": {"type": "integer"},
    "input_snapshot_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[^\\\\]+(?:/[^\\\\]+)*$"}, "uniqueItems": true},
    "input_snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "catalog_provenance": {"type": "object", "additionalProperties": false, "required": ["canonical_item_ids_sha256", "pinned_catalog_paths", "pinned_catalog_sha256"], "properties": {"canonical_item_ids_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}, "pinned_catalog_paths": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "pattern": "^[^\\\\]+(?:/[^\\\\]+)*$"}}, "pinned_catalog_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}}},
    "training": {"type": "object", "required": ["eligible_rows", "minimum_rows", "feature_group_count", "outer_cv_mae"], "properties": {"eligible_rows": {"type": "integer", "minimum": 0}, "minimum_rows": {"type": "integer", "minimum": 100}, "feature_group_count": {"type": "integer", "minimum": 0}, "outer_cv_mae": {"type": ["number", "null"], "minimum": 0}}},
    "publication_gate": {"type": "object", "required": ["status"], "properties": {"status": {"const": "not_evaluated"}}},
    "feature_schema": {"type": "object"},
    "prediction_contract": {"type": "object"},
    "rejected_rows": {"type": "array"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "artifact": {"type": ["object", "null"]}
  }
}
