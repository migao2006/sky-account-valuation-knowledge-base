{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "modeling/publication-evaluation.schema.json",
  "title": "Replayable model publication evaluation state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "publication_ready", "artifact_publication_fields_consulted", "feature_evaluator_contract", "dataset_sha256", "dataset_manifest_sha256", "split_sha256", "artifact_bindings", "requirements", "eligible_market_pools", "metrics", "blocking_reasons"],
  "properties": {
    "schema_version": {"const": "1.4-p3.8"},
    "status": {"enum": ["not_ready", "evaluation_required", "passed", "failed"]},
    "publication_ready": {"type": "boolean"},
    "artifact_publication_fields_consulted": {"const": false},
    "feature_evaluator_contract": {"type": "object", "additionalProperties": false, "required": ["schema_version", "feature_source", "target", "dates_used_only_for"], "properties": {"schema_version": {"const": "publication-feature-evaluator-v1"}, "feature_source": {"const": "signed_feature_payload.feature_groups"}, "target": {"const": "selected_price_twd"}, "dates_used_only_for": {"const": ["time_forward_split", "comparable_selector_baseline"]}}},
    "dataset_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "dataset_manifest_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "split_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "artifact_bindings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["price_line", "model_type", "dataset_sha256", "dataset_manifest_sha256", "split_sha256", "model_sha256", "artifact_sha256"], "properties": {"price_line": {"enum": ["normal_listing", "urgent_sale", "verified_sale"]}, "model_type": {"type": "string", "minLength": 1}, "dataset_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}, "dataset_manifest_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}, "split_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}, "model_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}, "artifact_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}}}},
    "requirements": {"type": "object", "additionalProperties": false, "required": ["training_clusters", "holdout_clusters", "minimum_subgroup_holdout_cases"], "properties": {"training_clusters": {"const": 300}, "holdout_clusters": {"const": 100}, "minimum_subgroup_holdout_cases": {"const": 30}}},
    "eligible_market_pools": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["currency", "server", "price_line", "training_cluster_count", "holdout_cluster_count", "cut_date"], "properties": {"currency": {"const": "TWD"}, "server": {"const": "international"}, "price_line": {"enum": ["normal_listing", "urgent_sale", "verified_sale"]}, "training_cluster_count": {"type": "integer", "minimum": 300}, "holdout_cluster_count": {"type": "integer", "minimum": 100}, "cut_date": {"type": "string", "format": "date"}}}},
    "metrics": {"type": ["object", "null"], "description": "Only evaluator-recomputed metrics are permitted; externally supplied artifact metrics and predictions are rejected."},
    "blocking_reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  },
  "allOf": [
    {"if": {"properties": {"publication_ready": {"const": true}}}, "then": {"properties": {"status": {"const": "passed"}, "metrics": {"type": "object"}, "artifact_bindings": {"minItems": 1}, "blocking_reasons": {"maxItems": 0}}}},
    {"if": {"properties": {"status": {"enum": ["not_ready", "evaluation_required", "failed"]}}}, "then": {"properties": {"publication_ready": {"const": false}, "blocking_reasons": {"minItems": 1}}}}
  ]
}
