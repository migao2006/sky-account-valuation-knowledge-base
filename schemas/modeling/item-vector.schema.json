{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "modeling/item-vector.schema.json",
  "title": "Offline account item vector",
  "description": "Deterministic, claim-based item vector. Unknown means no evidence, not absence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "vector_id", "account_id", "source_listing_ids", "catalog_provenance", "item_states", "feature_groups", "parser_summary", "review_status"],
  "properties": {
    "schema_version": {"const": "3.1-p1"},
    "vector_id": {"type": "string", "pattern": "^vector_account_[a-z0-9_]+$"},
    "account_id": {"type": "string", "pattern": "^account_[a-z0-9_]+$"},
    "source_listing_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^listing_[a-z0-9_]+$"}},
    "catalog_provenance": {"type": "object", "additionalProperties": false, "required": ["canonical_item_ids_sha256", "pinned_catalog_paths", "pinned_catalog_sha256"], "properties": {"canonical_item_ids_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}, "pinned_catalog_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(knowledge/items/items|knowledge/aliases/item-aliases|knowledge/sets/item-sets)\\.jsonl$"}}, "pinned_catalog_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}}},
    "item_states": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["item_id", "state", "evidence_state", "match_types", "matched_aliases", "matched_sources", "model_feature", "sensitivity_feature", "conflict", "review_status"], "properties": {"item_id": {"type": "string", "pattern": "^item_[a-z0-9_]+$"}, "state": {"enum": ["owned", "confirmed_missing", "unknown"]}, "evidence_state": {"enum": ["profile_claim", "text_claim", "unknown", "conflict"]}, "match_types": {"type": "array", "uniqueItems": true, "items": {"enum": ["profile_owned", "profile_missing", "canonical_name", "alias", "explicit_negative"]}}, "matched_aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "matched_sources": {"type": "array", "uniqueItems": true, "items": {"enum": ["listing_text", "normalized_feature_summary"]}}, "model_feature": {"type": "boolean"}, "sensitivity_feature": {"type": "boolean"}, "conflict": {"type": "boolean"}, "review_status": {"enum": ["approved", "needs_review", "unknown"]}}}},
    "feature_groups": {"type": "object", "additionalProperties": false, "required": ["season_profiles", "item_sets", "collection", "resources", "map_completion", "base_account", "bindings", "ownership_history"], "properties": {"season_profiles": {"type": "array", "items": {"type": "object"}}, "item_sets": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["set_id", "owned_item_ids", "confirmed_missing_item_ids", "member_count", "known_member_count", "completion_ratio", "is_complete", "model_feature"], "properties": {"set_id": {"type": "string", "pattern": "^set_[a-z0-9_]+$"}, "owned_item_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^item_[a-z0-9_]+$"}}, "confirmed_missing_item_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^item_[a-z0-9_]+$"}}, "member_count": {"type": "integer", "minimum": 0}, "known_member_count": {"type": "integer", "minimum": 0}, "completion_ratio": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "is_complete": {"type": ["boolean", "null"]}, "model_feature": {"type": "boolean"}}}}, "collection": {"type": "object"}, "resources": {"type": "object"}, "map_completion": {"type": "object"}, "base_account": {"type": "object"}, "bindings": {"type": "object"}, "ownership_history": {"type": "string"}}},
    "parser_summary": {"type": "object", "additionalProperties": false, "required": ["method", "catalog_item_count", "approved_item_count", "needs_review_item_count", "text_matched_item_count", "listing_text_matched_item_count", "feature_summary_matched_item_count", "profile_owned_item_count", "profile_missing_item_count", "conflict_item_count"], "properties": {"method": {"const": "offline_alias_rules_v1"}, "catalog_item_count": {"type": "integer", "minimum": 0}, "approved_item_count": {"type": "integer", "minimum": 0}, "needs_review_item_count": {"type": "integer", "minimum": 0}, "text_matched_item_count": {"type": "integer", "minimum": 0}, "listing_text_matched_item_count": {"type": "integer", "minimum": 0}, "feature_summary_matched_item_count": {"type": "integer", "minimum": 0}, "profile_owned_item_count": {"type": "integer", "minimum": 0}, "profile_missing_item_count": {"type": "integer", "minimum": 0}, "conflict_item_count": {"type": "integer", "minimum": 0}}},
    "review_status": {"enum": ["approved", "needs_review", "unknown"]}
  }
}
