{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "modeling/xgboost-artifact.schema.json",
  "title": "Offline XGBoost training artifact",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "model_type", "status", "price_line", "input_snapshot_paths", "input_snapshot_sha256", "catalog_provenance", "feature_schema", "training", "publication_gate", "prediction_contract", "model_file"],
  "properties": {
    "schema_version": {"const": "3.1-p1"},
    "model_type": {"const": "xgboost"},
    "status": {"enum": ["trained", "insufficient_training_data", "dependency_unavailable", "training_failed"]},
    "price_line": {"enum": ["normal_listing", "urgent_sale"]},
    "input_snapshot_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "input_snapshot_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "catalog_provenance": {"type": "object", "additionalProperties": false, "required": ["canonical_item_ids_sha256", "pinned_catalog_paths", "pinned_catalog_sha256"], "properties": {"canonical_item_ids_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}, "pinned_catalog_paths": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "pinned_catalog_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}}},
    "feature_schema": {"type": "object", "required": ["version", "feature_names", "feature_groups"]},
    "training": {"type": "object", "required": ["records", "min_required_records", "effective_feature_groups", "seed", "outer_cv_mae"], "properties": {"outer_cv_mae": {"type": ["number", "null"]}}},
    "publication_gate": {"type": "object", "required": ["status"], "properties": {"status": {"const": "not_evaluated"}}},
    "prediction_contract": {"type": "object", "required": ["target", "transform", "interval_supported"]},
    "model_file": {"type": ["string", "null"]},
    "model_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}
  }
}
