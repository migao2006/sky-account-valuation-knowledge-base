{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "market/comparable-account.schema.json",
  "title": "Joined offline comparable account",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "comparable_id", "history_id", "account_id", "source_listing_ids", "base_account",
    "season_profiles", "season_summary", "collection", "map_completion", "resources", "bindings", "ownership_history", "trade_conditions", "evidence_quality", "review_status",
    "selected_price_twd", "price_history_twd", "price_type", "status", "post_date", "observed_at", "date_verified", "date_evidence_state", "currency", "currency_verified", "server", "server_verified", "offer_kind", "entity_kind", "market_pool", "market_evidence_quality", "sale_outcome"
  ],
  "properties": {
    "schema_version": {"const": "3.0-p0"},
    "comparable_id": {"type": "string", "pattern": "^history_[a-z0-9_]+$"},
    "history_id": {"type": "string", "pattern": "^history_[a-z0-9_]+$"},
    "account_id": {"type": "string", "pattern": "^account_[a-z0-9_]+$"},
    "source_listing_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^listing_[a-z0-9_]+$"}, "uniqueItems": true}, "base_account": {"type": "object"},
    "season_profiles": {"type": "array"}, "season_summary": {"type": "object"}, "collection": {"type": "object"}, "map_completion": {"type": "object"}, "resources": {"type": "object"}, "bindings": {"type": "object"}, "ownership_history": {"enum": ["first_owner", "second_owner", "multiple_owners", "first_hand_claimed", "second_hand_or_more", "multiple_previous_owners", "unknown"]}, "trade_conditions": {"type": "object"}, "evidence_quality": {"type": "object"}, "review_status": {"enum": ["approved", "needs_review", "unknown"]},
    "selected_price_twd": {"type": ["number", "null"], "minimum": 0}, "price_history_twd": {"type": "array", "items": {"type": "number", "minimum": 0}}, "price_type": {"type": "string"}, "status": {"type": "string"}, "observed_at": {"type": "string", "format": "date"},
    "currency": {"type": "string"}, "currency_verified": {"type": "boolean"}, "server": {"type": "string"}, "server_verified": {"type": "boolean"}, "offer_kind": {"type": "string"}, "entity_kind": {"type": "string"}, "market_pool": {"type": "string"}, "market_evidence_quality": {"type": "string"},
    "post_date": {"type": ["string", "null"], "format": "date"},
    "date_verified": {"type": "boolean"},
    "date_evidence_state": {"enum": ["verified", "unknown"]},
    "sale_outcome": {"type": "object"}
  }
}
