{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "market/account-profile.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "account_id", "source_listing_ids", "post_date", "date_verified", "date_evidence_state", "base_account", "season_profiles", "season_summary", "field_evidence", "collection", "map_completion", "resources", "bindings", "ownership_history", "trade_conditions", "evidence_quality", "review_status"],
  "properties": {
    "schema_version": {"const": "3.0-p0"}, "account_id": {"type": "string", "pattern": "^account_[a-z0-9_]+$"}, "source_listing_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^listing_[a-z0-9_]+$"}, "uniqueItems": true}, "post_date": {"type": ["string", "null"], "format": "date"}, "date_verified": {"type": "boolean"}, "date_evidence_state": {"enum": ["verified", "unknown"]}, "base_account": {"type": "object", "additionalProperties": false, "required": ["account_type", "wing_state", "special_appearance", "short_id"], "properties": {"account_type": {"type": "string"}, "wing_state": {"type": "string"}, "special_appearance": {"type": "array", "items": {"type": "string"}}, "short_id": {"type": "string"}}},
    "season_profiles": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["season_id", "status", "completion_ratio", "pass_owned", "ultimate_reward_owned", "owned_item_ids", "missing_item_ids", "evidence_state", "evidence_sources", "capture_date", "review_status"], "properties": {"season_id": {"type": "string", "pattern": "^season_[a-z0-9_]+$"}, "status": {"enum": ["complete", "partial", "owned_not_complete", "confirmed_missing", "unknown"]}, "completion_ratio": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "pass_owned": {"enum": ["yes", "no", "unknown"]}, "ultimate_reward_owned": {"enum": ["yes", "no", "unknown"]}, "owned_item_ids": {"type": "array", "items": {"type": "string", "pattern": "^item_[a-z0-9_]+$"}, "uniqueItems": true}, "missing_item_ids": {"type": "array", "items": {"type": "string", "pattern": "^item_[a-z0-9_]+$"}, "uniqueItems": true}, "evidence_state": {"enum": ["image_confirmed", "text_claim", "unknown", "conflict"]}, "evidence_sources": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "capture_date": {"type": ["string", "null"], "format": "date"}, "review_status": {"enum": ["approved", "needs_review"]}}}},
    "season_summary": {"type": "object", "additionalProperties": false, "required": ["earliest_season_id", "earliest_complete_season_id", "complete_count", "partial_count", "pass_not_complete_count", "continuous_segments", "gap_segments", "evidence_state"], "properties": {"earliest_season_id": {"type": ["string", "null"], "pattern": "^season_[a-z0-9_]+$"}, "earliest_complete_season_id": {"type": ["string", "null"], "pattern": "^season_[a-z0-9_]+$"}, "complete_count": {"type": "integer", "minimum": 0}, "partial_count": {"type": "integer", "minimum": 0}, "pass_not_complete_count": {"type": "integer", "minimum": 0}, "continuous_segments": {"type": "array", "items": {"type": "object"}}, "gap_segments": {"type": "array", "items": {"type": "object"}}, "evidence_state": {"enum": ["image_confirmed", "text_claim", "unknown", "conflict"]}}},
    "field_evidence": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["sources", "evidence_state"], "properties": {"sources": {"type": "array", "items": {"enum": ["listing_text", "normalized_feature_summary"]}, "uniqueItems": true}, "evidence_state": {"enum": ["text_claim", "unknown", "conflict"]}, "claim_kind": {"enum": ["approximate"]}}}},
    "collection": {"type": "object", "additionalProperties": false, "required": ["owned_item_ids", "item_set_profiles", "graduation_rewards", "graduation_reward_season_ids", "collaboration_items", "bundle_claim_level"], "properties": {"owned_item_ids": {"type": "array", "items": {"type": "string", "pattern": "^item_[a-z0-9_]+$"}, "uniqueItems": true}, "item_set_profiles": {"type": "array", "items": {"type": "object"}}, "graduation_rewards": {"type": "array", "items": {"type": "string", "pattern": "^item_[a-z0-9_]+$"}, "uniqueItems": true}, "graduation_reward_season_ids": {"type": "array", "items": {"type": "string", "pattern": "^season_[a-z0-9_]+$"}, "uniqueItems": true}, "collaboration_items": {"type": "array", "items": {"type": "string", "pattern": "^item_[a-z0-9_]+$"}, "uniqueItems": true}, "bundle_item_ids": {"type": "array", "items": {"type": "string", "pattern": "^item_[a-z0-9_]+$"}, "uniqueItems": true}, "event_limited_item_ids": {"type": "array", "items": {"type": "string", "pattern": "^item_[a-z0-9_]+$"}, "uniqueItems": true}, "bundle_claim_level": {"enum": ["none", "partial", "complete", "unknown"]}}},
    "map_completion": {"type": "object", "additionalProperties": false, "required": ["standard_maps", "second_tier_capes", "evidence_state"], "properties": {"standard_maps": {"enum": ["complete", "partial", "unknown"]}, "second_tier_capes": {"enum": ["complete", "partial", "unknown"]}, "evidence_state": {"enum": ["image_confirmed", "text_claim", "unknown", "conflict"]}}},
    "resources": {"type": "object", "additionalProperties": false, "required": ["values", "capture_date", "evidence_state"], "properties": {"values": {"type": "object", "additionalProperties": false, "required": ["white_candles", "hearts", "red_candles", "season_candles"], "properties": {"white_candles": {"type": ["integer", "null"], "minimum": 0}, "hearts": {"type": ["integer", "null"], "minimum": 0}, "red_candles": {"type": ["integer", "null"], "minimum": 0}, "season_candles": {"type": ["integer", "null"], "minimum": 0}}}, "capture_date": {"type": ["string", "null"], "format": "date"}, "evidence_state": {"enum": ["image_confirmed", "text_claim", "unknown", "conflict"]}}},
    "bindings": {"type": "object", "additionalProperties": false, "required": ["platforms", "risk_state"], "properties": {"platforms": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["platform", "status", "evidence_state"], "properties": {"platform": {"enum": ["google", "apple", "facebook", "nintendo", "playstation", "steam", "huawei", "twitter", "other"]}, "status": {"enum": ["available", "unavailable", "mentioned_unknown", "unknown", "high_risk"]}, "evidence_state": {"enum": ["image_confirmed", "text_claim", "unknown", "conflict"]}}}}, "risk_state": {"enum": ["low", "restricted", "high_risk", "unknown"]}}}, "ownership_history": {"enum": ["first_owner", "second_owner", "multiple_owners", "first_hand_claimed", "second_hand_or_more", "multiple_previous_owners", "unknown"]}, "trade_conditions": {"type": "object", "additionalProperties": false, "required": ["offer_kind", "entity_kind", "price_type"], "properties": {"offer_kind": {"type": "string"}, "entity_kind": {"type": "string"}, "price_type": {"type": "string"}}}, "evidence_quality": {"type": "object", "additionalProperties": false, "required": ["listing_text", "image", "ocr"], "properties": {"listing_text": {"enum": ["high", "medium", "low", "unknown"]}, "image": {"enum": ["confirmed", "not_collected", "unknown"]}, "ocr": {"enum": ["confirmed", "not_collected", "unknown"]}}}, "review_status": {"enum": ["approved", "needs_review", "unknown"]}
  }
}
