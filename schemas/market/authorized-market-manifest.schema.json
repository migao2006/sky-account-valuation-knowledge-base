{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "market/authorized-market-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "observations_path", "observations_sha256", "observation_digests"],
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "authorized-market-manifest-v2"}}},
      "then": {"required": ["training_examples_path", "training_examples_sha256", "training_example_digests"]}
    }
  ],
  "properties": {
    "schema_version": {"enum": ["authorized-market-manifest-v1", "authorized-market-manifest-v2"]},
    "dataset_id": {"type": "string", "pattern": "^authorized_market_[a-z0-9_]+$"},
    "observations_path": {"type": "string", "pattern": "^data/review/market-authorization/datasets/[a-z0-9_/-]+/observations\\.jsonl$"},
    "observations_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "observation_digests": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["observation_id", "row_digest", "dedup_cluster_digest"], "properties": {"observation_id": {"type": "string", "pattern": "^observation_[a-z0-9_]+$"}, "row_digest": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}, "dedup_cluster_digest": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}}}},
    "training_examples_path": {"type": "string", "pattern": "^data/review/market-authorization/datasets/[a-z0-9_/-]+/training-examples\\.jsonl$"},
    "training_examples_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "training_example_digests": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["training_example_id", "training_example_digest", "observation_id", "account_id", "feature_payload_sha256", "catalog_provenance_sha256", "dedup_cluster_digest"], "properties": {"training_example_id": {"type": "string", "pattern": "^training_example_[a-z0-9_]+$"}, "training_example_digest": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}, "observation_id": {"type": "string", "pattern": "^observation_[a-z0-9_]+$"}, "account_id": {"type": "string", "pattern": "^account_[a-z0-9_]+$"}, "feature_payload_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}, "catalog_provenance_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}, "dedup_cluster_digest": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}}}}
  }
}
