{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "market/history.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "history_id", "legacy_key", "source_listing_ids", "account_id", "selected_price_twd", "price_history_twd", "price_type", "status", "post_date", "observed_at", "date_verified", "date_evidence_state", "currency", "currency_verified", "server", "server_verified", "offer_kind", "entity_kind", "market_pool", "legacy_features", "legacy_risks", "evidence_quality", "sale_outcome"],
  "properties": {
    "schema_version": {"const": "3.0-p0"}, "history_id": {"type": "string", "pattern": "^history_[a-z0-9_]+$"}, "legacy_key": {"type": "string", "minLength": 1}, "source_listing_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^listing_[a-z0-9_]+$"}, "uniqueItems": true}, "account_id": {"type": "string", "pattern": "^account_[a-z0-9_]+$"}, "selected_price_twd": {"type": ["number", "null"], "minimum": 0}, "price_history_twd": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0}}, "price_type": {"enum": ["asking", "reduced", "instant", "normal_listing", "urgent_sale", "last_public_price", "sold_claim", "verified_sale", "unknown"]}, "status": {"enum": ["active", "sold_claimed", "completed_verified", "withdrawn", "unknown"]}, "post_date": {"type": ["string", "null"], "format": "date"}, "observed_at": {"type": "string", "format": "date"}, "date_verified": {"type": "boolean"}, "date_evidence_state": {"enum": ["verified", "unverified", "unknown", "conflict"]}, "currency": {"type": "string"}, "currency_verified": {"type": "boolean"}, "server": {"type": "string"}, "server_verified": {"type": "boolean"}, "offer_kind": {"type": "string"}, "entity_kind": {"type": "string"}, "market_pool": {"type": "string"}, "legacy_features": {"type": "array", "items": {"type": "string"}}, "legacy_risks": {"type": "array", "items": {"type": "string"}}, "evidence_quality": {"enum": ["high", "medium", "low", "unknown"]}, "sale_outcome": {"type": "object", "additionalProperties": false, "required": ["status", "completed_sale_price_twd", "verified"], "properties": {"status": {"enum": ["not_observed", "sold_claimed", "completed_verified", "unknown"]}, "completed_sale_price_twd": {"type": ["number", "null"], "minimum": 0}, "verified": {"type": "boolean"}}}, "price_semantic_review": {"type": "object", "additionalProperties": false, "required": ["urgency", "brokerage_included", "evidence_state", "review_status", "reason_codes"], "properties": {"urgency": {"enum": ["urgent_sale", "unknown"]}, "brokerage_included": {"const": true}, "evidence_state": {"const": "text_claim"}, "review_status": {"const": "needs_review"}, "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}}}}, "recovery": {"type": "object", "additionalProperties": false, "required": ["method", "reason", "source_layer", "source_listing_id", "legacy_history_match", "predicates"], "properties": {"method": {"const": "strict_normalized_listing_recovery_v1"}, "reason": {"type": "string", "minLength": 1}, "source_layer": {"const": "data/normalized/listings.jsonl"}, "source_listing_id": {"type": "string", "pattern": "^listing_[a-z0-9_]+$"}, "legacy_history_match": {"const": "none"}, "predicates": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}}}
  },
  "allOf": [{"if": {"properties": {"date_verified": {"const": true}}}, "then": {"properties": {"post_date": {"type": "string", "format": "date"}, "date_evidence_state": {"const": "verified"}}, "required": ["post_date"]}}]
}
