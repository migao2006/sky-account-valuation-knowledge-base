{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "market/authorized-market-training-example.schema.json",
  "title": "Signed PII-free market training example",
  "type": "object",
  "additionalProperties": false,
  "required": ["training_example_id", "observation_id", "account_id", "feature_payload", "feature_payload_sha256", "catalog_provenance", "catalog_provenance_sha256", "dedup_cluster_id", "dedup_cluster_digest", "training_example_digest"],
  "properties": {
    "training_example_id": {"type": "string", "pattern": "^training_example_[a-z0-9_]+$"},
    "observation_id": {"type": "string", "pattern": "^observation_[a-z0-9_]+$"},
    "account_id": {"type": "string", "pattern": "^account_[a-z0-9_]+$"},
    "feature_payload": {"type": "object"},
    "feature_payload_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "catalog_provenance": {"type": "object"},
    "catalog_provenance_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "dedup_cluster_id": {"type": "string", "pattern": "^cluster_[a-z0-9_]+$"},
    "dedup_cluster_digest": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "training_example_digest": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "observation_row_digest": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "price_line": {"const": "verified_sale"},
    "completed_sale_verified": {"const": true},
    "sale_verified": {"const": true},
    "completion_evidence_digest": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "independent_evidence_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^evidence_[a-z0-9_]+$"}}
  },
  "allOf": [
    {
      "if": {"required": ["price_line"]},
      "then": {"required": ["observation_row_digest", "price_line", "completed_sale_verified", "sale_verified", "completion_evidence_digest", "independent_evidence_ids"]}
    }
  ]
}
