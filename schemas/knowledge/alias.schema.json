{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge/alias.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["alias_id", "alias_text", "normalized_alias", "language", "target_type", "target_id", "source_ids", "verification_status"],
  "properties": {
    "alias_id": {"type": "string", "pattern": "^alias_[a-z0-9_]+$"}, "alias_text": {"type": "string", "minLength": 1}, "normalized_alias": {"type": "string", "minLength": 1},
    "language": {"enum": ["zh_tw", "zh_cn", "en", "ja", "ko", "other", "unknown"]}, "target_type": {"enum": ["season", "event", "item", "set", "ancestor"]},
    "target_id": {"type": "string", "pattern": "^(season|event|item|set|ancestor)_[a-z0-9_]+$"}, "source_ids": {"$ref": "common.schema.json#/$defs/sourceIds"}, "verification_status": {"$ref": "common.schema.json#/$defs/verificationStatus"}
  }
}
