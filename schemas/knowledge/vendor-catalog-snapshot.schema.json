{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge/vendor-catalog-snapshot.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshot_format", "source_package", "source_version", "source_git_commit", "items"],
  "properties": {
    "snapshot_format": {"const": "skygame-data-items-v1"},
    "source_package": {"const": "skygame-data"},
    "source_version": {"const": "1.3.4"},
    "source_git_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "guid", "name", "type", "subtype", "group"],
        "properties": {
          "id": {"type": "integer", "minimum": 0},
          "guid": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "subtype": {"type": ["string", "null"]},
          "group": {"type": ["string", "null"]}
        }
      }
    }
  }
}
