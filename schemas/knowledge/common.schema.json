{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge/common.schema.json",
  "$defs": {
    "sourceIds": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^source_[a-z0-9_]+$"}, "uniqueItems": true},
    "verificationStatus": {"enum": ["verified", "needs_review", "unknown"]},
    "availabilityStatus": {"enum": ["permanent", "recurring_event", "traveling_spirit_rotation", "limited_time", "temporarily_unavailable", "officially_discontinued", "unknown"]}
  }
}
