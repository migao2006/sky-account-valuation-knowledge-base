{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge/vendor-catalog-metadata.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshot_id", "source_id", "source_name", "source_type", "upstream_repository", "source_package", "source_version", "source_git_commit", "license", "npm_tarball_sha1", "npm_integrity_sha512", "tarball_path", "tarball_sha256", "license_member", "license_sha256", "original_asset_member", "everything_asset_member", "everything_items_match", "snapshot_path", "snapshot_sha256", "record_count", "imported_at", "evidence_level", "canonical_promotion", "notes"],
  "properties": {
    "snapshot_id": {"const": "vendor_skygame_data_1_3_4"},
    "source_id": {"const": "source_skygame_data_1_3_4"},
    "source_name": {"type": "string", "minLength": 1},
    "source_type": {"const": "community_database"},
    "upstream_repository": {"type": "string", "format": "uri"},
    "source_package": {"const": "skygame-data"},
    "source_version": {"const": "1.3.4"},
    "source_git_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "license": {"const": "MIT"},
    "npm_tarball_sha1": {"type": "string", "pattern": "^[A-F0-9]{40}$"},
    "npm_integrity_sha512": {"type": "string", "minLength": 1},
    "tarball_path": {"const": "data/source/vendor/skygame-data-1.3.4.tgz"},
    "tarball_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "license_member": {"const": "package/LICENSE"},
    "license_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "original_asset_member": {"const": "package/assets/items.json"},
    "everything_asset_member": {"const": "package/assets/everything.json"},
    "everything_items_match": {"const": true},
    "snapshot_path": {"const": "data/source/vendor/skygame-data-1.3.4-items.json"},
    "snapshot_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "record_count": {"type": "integer", "minimum": 1},
    "imported_at": {"type": "string", "format": "date"},
    "evidence_level": {"const": "single_secondary_needs_review"},
    "canonical_promotion": {"const": "prohibited_without_independent_review"},
    "notes": {"type": "string", "minLength": 1}
  }
}
