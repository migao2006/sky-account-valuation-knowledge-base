{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reports/catalog-completion.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_status", "complete", "counts", "checks", "blocking_contract_ids"],
  "properties": {
    "schema_version": {"const": "1.3-p4.1"},
    "catalog_status": {"enum": ["partial", "complete"]},
    "complete": {"type": "boolean"},
    "counts": {"type": "object", "additionalProperties": {"type": ["integer", "null"]}},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["contract_id", "passed", "actual", "requirement", "evidence_paths"], "properties": {"contract_id": {"type": "string", "pattern": "^catalog\\."}, "passed": {"type": "boolean"}, "actual": {}, "requirement": {"type": "string"}, "evidence_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}}},
    "blocking_contract_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^catalog\\."}}
  }
}
