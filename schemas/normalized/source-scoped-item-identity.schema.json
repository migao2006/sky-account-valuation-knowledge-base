{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "normalized/source-scoped-item-identity.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["reference_identity_id", "identity_scope", "canonical_identity_status", "promotion_eligibility", "snapshot_id", "source_id", "source_snapshot_sha256", "vendor_item_id", "vendor_guid", "observed_name", "observed_item_type", "normalized_name", "name_cluster", "link_status", "crosswalk_match_status", "canonical_item_ids", "candidate_item_ids", "review_status", "model_feature_status"],
  "properties": {
    "reference_identity_id": {"type": "string", "pattern": "^reference_identity_[a-f0-9]{32}$"},
    "identity_scope": {"const": "source_snapshot_only"},
    "canonical_identity_status": {"const": "unverified"},
    "promotion_eligibility": {"const": "prohibited"},
    "snapshot_id": {"const": "vendor_skygame_data_1_3_4"},
    "source_id": {"const": "source_skygame_data_1_3_4"},
    "source_snapshot_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "vendor_item_id": {"type": "integer", "minimum": 0},
    "vendor_guid": {"type": "string", "minLength": 1},
    "observed_name": {"type": "string", "minLength": 1},
    "observed_item_type": {"enum": ["HairAccessory", "HeadAccessory", "Hair", "Mask", "FaceAccessory", "Necklace", "Outfit", "Shoes", "OutfitShoes", "Cape", "Held", "Furniture", "Prop", "Music", "Emote", "Stance", "Call"]},
    "normalized_name": {"type": "string", "minLength": 1},
    "name_cluster": {"type": "object", "additionalProperties": false, "required": ["cluster_id", "snapshot_member_count", "collectible_member_count", "observed_item_types", "cross_type_conflict"], "properties": {"cluster_id": {"type": "string", "pattern": "^vendor_name_[a-f0-9]{20}$"}, "snapshot_member_count": {"type": "integer", "minimum": 1}, "collectible_member_count": {"type": "integer", "minimum": 1}, "observed_item_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "cross_type_conflict": {"type": "boolean"}}},
    "link_status": {"enum": ["canonical_link", "candidate_link", "unresolved"]},
    "crosswalk_match_status": {"enum": ["matched_canonical_name", "matched_alias", "ambiguous_canonical_match", "matched_candidate_name", "ambiguous_candidate_match", "unmatched_vendor_item"]},
    "canonical_item_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^item_[a-z0-9_]+$"}},
    "candidate_item_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^item_[a-z0-9_]+$"}},
    "review_status": {"enum": ["needs_review", "quarantined_cross_type_conflict"]},
    "model_feature_status": {"const": "excluded_pending_verification"}
  }
}
