{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "normalized/source-scoped-item-identities-summary.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["identity_scope", "canonical_identity_status", "promotion_eligibility", "snapshot_id", "source_id", "source_snapshot_sha256", "vendor_item_count", "collectible_record_count", "excluded_non_collectible_count", "link_status_counts", "canonical_link_count", "candidate_link_count", "unresolved_count", "cross_type_conflict_cluster_count", "cross_type_conflict_collectible_cluster_count", "cross_type_conflict_collectible_record_count", "model_feature_status", "notes"],
  "properties": {
    "identity_scope": {"const": "source_snapshot_only"},
    "canonical_identity_status": {"const": "unverified"},
    "promotion_eligibility": {"const": "prohibited"},
    "snapshot_id": {"const": "vendor_skygame_data_1_3_4"},
    "source_id": {"const": "source_skygame_data_1_3_4"},
    "source_snapshot_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "vendor_item_count": {"const": 3266},
    "collectible_record_count": {"const": 1758},
    "excluded_non_collectible_count": {"const": 1508},
    "link_status_counts": {"type": "object", "additionalProperties": false, "required": ["canonical_link", "candidate_link", "unresolved"], "properties": {"canonical_link": {"const": 64}, "candidate_link": {"const": 296}, "unresolved": {"const": 1398}}},
    "canonical_link_count": {"const": 64},
    "candidate_link_count": {"const": 296},
    "unresolved_count": {"const": 1398},
    "cross_type_conflict_cluster_count": {"const": 16},
    "cross_type_conflict_collectible_cluster_count": {"const": 11},
    "cross_type_conflict_collectible_record_count": {"const": 26},
    "model_feature_status": {"const": "excluded_pending_verification"},
    "notes": {"type": "string", "minLength": 1}
  }
}
